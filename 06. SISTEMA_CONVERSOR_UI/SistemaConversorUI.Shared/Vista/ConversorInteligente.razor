@page "/conversor"
@inject ec.edu.monster.Servicios.EstadoAplicacion EstadoApp
@inject ec.edu.monster.Servicios.FabricaEstrategiaBackend Fabrica
@inject NavigationManager NavManager

<div class="app-layout">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded shadow-sm">
            <div>
                <h4 class="m-0 text-success">Conversor de Unidades</h4>
                <small class="text-muted">Entorno: <strong>@EstadoApp.BackendActual</strong> | Token: @(string.IsNullOrEmpty(EstadoApp.TokenActual) ? "Ninguno" : EstadoApp.TokenActual.Substring(0, 8) + "...")</small>
            </div>
            <div>
                <button class="btn btn-outline-secondary btn-sm me-2" @onclick='() => NavManager.NavigateTo("/cambiar-contrasenia")'>Perfil</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">Cerrar Sesión</button>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="card p-4 shadow-sm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Conversión</label>
                        <select class="form-select" value="@magnitudSeleccionada" @onchange="OnMagnitudChanged">
                            @foreach (var magnitud in Enum.GetValues<ec.edu.monster.Modelos.TipoMagnitud>())
                            {
                                <option value="@magnitud">@magnitud</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Valor</label>
                        <input type="number" class="form-control" @bind="peticion.Valor" />
                    </div>

                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label fw-bold">Unidad Inicial</label>
                            <select class="form-select" @bind="peticion.UnidadOrigen">
                                @RenderizarOpcionesUnidad()
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold">Unidad Final</label>
                            <select class="form-select" @bind="peticion.UnidadDestino">
                                @RenderizarOpcionesUnidad()
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col"><button class="btn btn-primary w-100" @onclick="EjecutarConversion">Convertir</button></div>
                        <div class="col"><button class="btn btn-secondary w-100" @onclick="Limpiar">Limpiar</button></div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger text-center">@mensajeError</div>
                    }

                    <div class="p-3 text-center rounded fw-bold text-white bg-success h5">
                        @textoResultado
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card p-4 shadow-sm">
                    <h6 class="fw-bold mb-3 text-secondary">Historial de Conversiones</h6>
                    <textarea class="form-control" style="height: 250px; resize: none;" readonly>@historial</textarea>
                </div>
            </div>
        </div>
    </div>
 </div>
 <style>
    .app-layout {
        min-height: 100vh;
        width: 100%;
        background: linear-gradient(135deg, #103553, #1979a9);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
</style>
@code {
    private ec.edu.monster.Modelos.TipoMagnitud magnitudSeleccionada = ec.edu.monster.Modelos.TipoMagnitud.Longitud;
    private ec.edu.monster.Modelos.PeticionConversion peticion = new ec.edu.monster.Modelos.PeticionConversion();
    private string textoResultado = "Resultado: listo para convertir";
    private string mensajeError = "";
    private string historial = "";

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(EstadoApp.TokenActual))
        {
            NavManager.NavigateTo("/");
            return;
        }
        EstablecerUnidadesPorDefecto(ec.edu.monster.Modelos.TipoMagnitud.Longitud);
    }

    private RenderFragment RenderizarOpcionesUnidad() => builder =>
    {
        int seq = 0;
        Array valoresEnum = magnitudSeleccionada switch
        {
            ec.edu.monster.Modelos.TipoMagnitud.Masa => Enum.GetValues(typeof(ec.edu.monster.Modelos.UnidadMasa)),
            ec.edu.monster.Modelos.TipoMagnitud.Temperatura => Enum.GetValues(typeof(ec.edu.monster.Modelos.UnidadTemperatura)),
            _ => Enum.GetValues(typeof(ec.edu.monster.Modelos.UnidadLongitud))
        };
        foreach (var val in valoresEnum)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", val.ToString());
            builder.AddContent(seq++, val.ToString());
            builder.CloseElement();
        }
    };

    private void OnMagnitudChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ec.edu.monster.Modelos.TipoMagnitud>(e.Value?.ToString(), out var nuevaMagnitud))
        {
            magnitudSeleccionada = nuevaMagnitud;
            EstablecerUnidadesPorDefecto(nuevaMagnitud);
        }
    }

    private void EstablecerUnidadesPorDefecto(ec.edu.monster.Modelos.TipoMagnitud magnitud)
    {
        peticion.TipoConversion = magnitud.ToString();
        peticion.UnidadOrigen = magnitud switch
        {
            ec.edu.monster.Modelos.TipoMagnitud.Masa => ec.edu.monster.Modelos.UnidadMasa.GRAMO.ToString(),
            ec.edu.monster.Modelos.TipoMagnitud.Temperatura => ec.edu.monster.Modelos.UnidadTemperatura.CELSIUS.ToString(),
            _ => ec.edu.monster.Modelos.UnidadLongitud.METRO.ToString()
        };
        peticion.UnidadDestino = magnitud switch
        {
            ec.edu.monster.Modelos.TipoMagnitud.Masa => ec.edu.monster.Modelos.UnidadMasa.KILOGRAMO.ToString(),
            ec.edu.monster.Modelos.TipoMagnitud.Temperatura => ec.edu.monster.Modelos.UnidadTemperatura.FAHRENHEIT.ToString(),
            _ => ec.edu.monster.Modelos.UnidadLongitud.MILIMETRO.ToString()
        };
    }

    private async Task EjecutarConversion()
    {
        mensajeError = "";
        textoResultado = "Calculando...";
        try
        {
            var adaptador = Fabrica.ObtenerAdaptadorConversion(EstadoApp.BackendActual);
            double resultadoNum = await adaptador.ConvertirAsync(peticion, EstadoApp.TokenActual);
            textoResultado = $"Resultado: {resultadoNum}";
            historial = $"[{DateTime.Now:HH:mm:ss}] {peticion.Valor} {peticion.UnidadOrigen} -> {resultadoNum} {peticion.UnidadDestino}\n" + historial;
        }
        catch (Exception ex)
        {
            textoResultado = "Error en conversión";
            mensajeError = ex.Message;
        }
    }

    private void Limpiar()
    {
        peticion.Valor = 0;
        textoResultado = "Resultado: listo para convertir";
        mensajeError = "";
    }

    private void CerrarSesion()
    {
        EstadoApp.TokenActual = string.Empty;
        NavManager.NavigateTo("/");
    }
}